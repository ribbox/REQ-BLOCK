<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Requirement Builder</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230f172a'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-size='36'%3E%F0%9F%A7%A9%3C/text%3E%3C/svg%3E">
  <script src="https://unpkg.com/blockly@11.2.1/blockly.min.js"></script>
  <style>
    :root {
      --bg: #0f172a;
      --panel: #1e293b;
      --accent: #38bdf8;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --success: #4ade80;
      --warning: #fbbf24;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    header {
      background: linear-gradient(90deg, #0c4a6e, #1e3a5f);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid var(--accent);
      flex-shrink: 0;
    }
    header h1 {
      font-size: 1.75rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
      line-height: 1;
      margin: 0;
      cursor: default;
    }
    .header-actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
    button, .btn {
      background: var(--accent);
      color: #0f172a;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      font-size: 0.9rem;
      transition: background 0.15s, transform 0.1s;
    }
    button:hover, .btn:hover { background: #7dd3fc; transform: translateY(-1px); }
    button:active { transform: translateY(0); }
    button.secondary {
      background: #334155;
      color: var(--text);
    }
    button.secondary:hover { background: #475569; }
    button.danger { background: #ef4444; color: white; }
    button.danger:hover { background: #f87171; }
    button.icon-btn {
      width: 40px;
      height: 40px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      line-height: 1;
      flex-shrink: 0;
    }
    button.icon-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }
    .header-sep {
      width: 1px;
      height: 24px;
      background: #475569;
      margin: 0 4px;
      flex-shrink: 0;
    }
    .main {
      flex: 1;
      display: flex;
      min-height: 0;
    }
    #blocklyArea {
      flex: 1;
      position: relative;
      min-width: 0;
    }
    #blocklyDiv {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
    }
    .sidebar {
      width: 340px;
      background: var(--panel);
      border-left: 1px solid #334155;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow: hidden;
      min-height: 0;
    }
    .sidebar-section {
      padding: 14px 16px;
      border-bottom: 1px solid #334155;
      min-height: 0;
    }
    .sidebar-section h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 10px;
    }
    #requirementOutput {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 12px;
      min-height: 80px;
      font-size: 1.05rem;
      line-height: 1.5;
      color: var(--success);
      word-wrap: break-word;
    }
    #requirementOutput.empty { color: var(--muted); font-style: italic; }
    .saved-list {
      flex: 1;
      overflow-y: auto;
      padding: 8px 0;
    }
    .saved-item {
      background: #0f172a;
      margin: 6px 12px;
      padding: 10px 12px;
      border-radius: 6px;
      border-left: 3px solid var(--accent);
      font-size: 0.92rem;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }
    .saved-item span { flex: 1; }
    .saved-item button {
      padding: 4px 8px;
      font-size: 0.75rem;
      background: #475569;
    }
    .hint {
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 8px;
      line-height: 1.4;
    }
    .page-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      margin-bottom: 10px;
    }
    .page-tab {
      background: #334155;
      color: var(--text);
      border: 1px solid #475569;
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .page-tab:hover { background: #475569; }
    .page-tab.active {
      background: var(--accent);
      color: #0f172a;
      border-color: var(--accent);
      font-weight: 600;
    }
    .page-actions {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }
    .page-actions button {
      padding: 5px 10px;
      font-size: 0.8rem;
    }
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    .modal-box {
      background: #1e293b;
      border: 1px solid #475569;
      border-radius: 10px;
      padding: 24px;
      max-width: 400px;
      width: 90%;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    .modal-box h3 {
      margin: 0 0 12px 0;
      font-size: 1.15rem;
      color: #f87171;
    }
    .modal-box p {
      margin: 0 0 20px 0;
      color: var(--text);
      line-height: 1.5;
      white-space: pre-line;
    }
    .modal-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      flex-wrap: wrap;
    }
    .modal-actions button {
      padding: 8px 16px;
    }
    .settings-field {
      margin-bottom: 14px;
    }
    .settings-field label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .settings-field input[type="text"],
    .settings-field input[type="url"] {
      width: 100%;
      padding: 8px 10px;
      border-radius: 6px;
      border: 1px solid #475569;
      background: #0f172a;
      color: var(--text);
      font-size: 0.9rem;
    }
    .settings-field input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .settings-note {
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.45;
      margin: 8px 0 16px 0;
      padding: 10px;
      background: #0f172a;
      border-radius: 6px;
      border-left: 3px solid var(--accent);
    }
    .settings-actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .type-legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      font-size: 0.8rem;
    }
    .icon-legend {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      margin: 8px 0 4px 0;
    }
    .icon-legend th,
    .icon-legend td {
      text-align: left;
      padding: 6px 8px;
      border-bottom: 1px solid #334155;
      vertical-align: middle;
    }
    .icon-legend th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .icon-legend td:first-child {
      width: 2.5rem;
      font-size: 1.15rem;
      text-align: center;
    }
    .type-swatch {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .swatch {
      width: 14px;
      height: 14px;
      border-radius: 3px;
    }
    .swatch.start { background: #4f46e5; }
    .swatch.capability { background: #0891b2; }
    .swatch.object { background: #059669; }
    .swatch.purpose { background: #d97706; }
    .swatch.condition { background: #dc2626; }
    .swatch.anyof { background: #c026d3; }
    .swatch.listitem { background: #e879f9; }
    .swatch.custom { background: #7c3aed; }
    .blocklyToolboxDiv {
      background: #1e293b !important;
      color: var(--text) !important;
    }
    .blocklyTreeLabel { color: var(--text) !important; }
    .blocklyTreeRow:hover { background: #334155 !important; }
    .blocklyFlyoutBackground { fill: #1e293b !important; }
  </style>
</head>
<body>
  <header>
    <h1 title="Requirement Builder">🧩</h1>
    <div class="header-actions">
      <button id="btnLegend" class="secondary icon-btn" title="Piece type key and connection rules" aria-label="Key">ℹ️</button>
      <span class="header-sep" aria-hidden="true"></span>
      <button id="btnSave" class="secondary icon-btn" title="Save requirement to this page’s list" aria-label="Save">💾</button>
      <button id="btnRemoteSaveHeader" class="icon-btn" title="Sync project to remote server" aria-label="Sync to server">☁️</button>
      <span class="header-sep" aria-hidden="true"></span>
      <button id="btnAddToLibrary" class="secondary icon-btn" title="Add selected piece to the library (same category)" aria-label="Add to library">📚</button>
      <button id="btnClear" class="secondary icon-btn" title="Clear workspace on this page" aria-label="Clear">🗑️</button>
      <span class="header-sep" aria-hidden="true"></span>
      <button id="btnSettings" class="secondary icon-btn" title="Settings, import/export, remote URL" aria-label="Settings">⚙️</button>
    </div>
  </header>

  <div class="main">
    <div id="blocklyArea">
      <div id="blocklyDiv"></div>
    </div>

    <aside class="sidebar">
      <div class="sidebar-section">
        <h2>Assembled Requirement</h2>
        <div id="requirementOutput" class="empty">Connect pieces on the left — the sentence updates live.</div>
        <p class="hint">Only compatible piece types snap together. Edit text by clicking a piece. Use <strong>ℹ️</strong> for the colour key, <strong>💾</strong> to save to this page, <strong>☁️</strong> to sync to the server.</p>
      </div>

      <div class="sidebar-section" style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
        <h2>Reusable Library</h2>
        <div id="libraryList" class="saved-list" style="flex: 1; overflow-y: auto; min-height: 80px;">
          <p class="hint" style="padding:0 12px;">No reusable pieces yet.</p>
        </div>
        <p class="hint" style="margin-top:6px; flex-shrink: 0;">Click ✕ to remove a piece from the library.</p>
      </div>

      <div class="sidebar-section" style="flex: 1.2; display: flex; flex-direction: column; min-height: 0;">
        <h2>Pages &amp; Saved Requirements</h2>
        <div class="page-bar">
          <div id="pageTabs"></div>
          <div class="page-actions">
            <button id="btnAddPage" class="secondary" title="Add a new page">+ Page</button>
            <button id="btnDeletePage" class="danger" title="Delete the current page">Delete Page</button>
          </div>
        </div>
        <p class="hint" style="margin: 0 0 8px 0; font-size: 0.75rem; flex-shrink: 0;">Double-click a page tab to rename it</p>
        <div id="savedList" class="saved-list" style="flex: 1; overflow-y: auto; min-height: 60px;">
          <p class="hint" style="padding:0 12px;">No requirements saved yet on this page.</p>
        </div>
      </div>
    </aside>
  </div>

  <script>
    // ========== Custom Blocks ==========
    // Connection type system:
    //   start     → next accepts "capability"
    //   capability→ previous "capability", next "object"
    //   object    → previous "object", next ["purpose","condition"]
    //   purpose   → previous "purpose"
    //   condition → previous "condition"
    //   any_of    → previous "object", next ["purpose","condition"],
    //               internal statement input accepts only "list_item"
    //   list_item → previous/next "list_item" (only lives inside any_of)
    //   custom    → flexible (can be used in several places)

    Blockly.defineBlocksWithJsonArray([
      // ---- START / MODAL ----
      {
        "type": "req_start",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "The system shall"
          }
        ],
        "nextStatement": "capability",
        "colour": 230,
        "tooltip": "Starting modal phrase (e.g. “The system shall”, “The user must”). Only connects to Capability pieces.",
        "helpUrl": ""
      },
      {
        "type": "req_start_alt",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "When <event>, the system shall"
          }
        ],
        "nextStatement": "capability",
        "colour": 230,
        "tooltip": "Event-driven start (EARS-style).",
        "helpUrl": ""
      },

      // ---- CAPABILITY / VERB PHRASE ----
      {
        "type": "req_capability",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "provide"
          }
        ],
        "previousStatement": "capability",
        "nextStatement": "object",
        "colour": 180,
        "tooltip": "What the system does (verb + high-level capability).",
        "helpUrl": ""
      },
      {
        "type": "req_capability_2",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "allow the user to"
          }
        ],
        "previousStatement": "capability",
        "nextStatement": "object",
        "colour": 180,
        "tooltip": "Capability phrasing focused on user action.",
        "helpUrl": ""
      },

      // ---- OBJECT ----
      {
        "type": "req_object",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "a function"
          }
        ],
        "previousStatement": "object",
        "nextStatement": ["purpose", "condition"],
        "colour": 160,
        "tooltip": "The thing being acted upon or produced.",
        "helpUrl": ""
      },
      {
        "type": "req_object_2",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "the current inventory status"
          }
        ],
        "previousStatement": "object",
        "nextStatement": ["purpose", "condition"],
        "colour": 160,
        "tooltip": "More specific object example.",
        "helpUrl": ""
      },

      // ---- PURPOSE ----
      {
        "type": "req_purpose",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "to produce a report"
          }
        ],
        "previousStatement": "purpose",
        "colour": 40,
        "tooltip": "Why / for what purpose (often starts with “to …”). Optional end piece.",
        "helpUrl": ""
      },
      {
        "type": "req_purpose_2",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "so that managers can make decisions"
          }
        ],
        "previousStatement": "purpose",
        "colour": 40,
        "tooltip": "Purpose / outcome phrasing.",
        "helpUrl": ""
      },

      // ---- CONDITION ----
      {
        "type": "req_condition",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "if the user is authenticated"
          }
        ],
        "previousStatement": "condition",
        "colour": 0,
        "tooltip": "Conditional constraint (if / while / unless …). Optional end piece.",
        "helpUrl": ""
      },
      {
        "type": "req_condition_2",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "while the system is in maintenance mode"
          }
        ],
        "previousStatement": "condition",
        "colour": 0,
        "tooltip": "State-driven condition.",
        "helpUrl": ""
      },

      // ---- ANY OF / LIST ----
      {
        "type": "req_any_of",
        "message0": "%1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "any of the following"
          }
        ],
        "message1": "%1",
        "args1": [
          {
            "type": "input_statement",
            "name": "ITEMS",
            "check": "list_item"
          }
        ],
        "previousStatement": "object",
        "nextStatement": ["purpose", "condition"],
        "colour": 300,
        "tooltip": "Introduces a list of discrete alternatives. The lead-in text is editable. Drag List-item pieces inside the C-shaped slot.",
        "helpUrl": ""
      },
      {
        "type": "req_list_item",
        "message0": "• %1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "option A"
          }
        ],
        "previousStatement": "list_item",
        "nextStatement": "list_item",
        "colour": 320,
        "tooltip": "A single discrete alternative. Only snaps inside an “any of the following” block.",
        "helpUrl": ""
      },

      // ---- CUSTOM (flexible) ----
      {
        "type": "req_custom",
        "message0": "🔧 %1",
        "args0": [
          {
            "type": "field_input",
            "name": "TEXT",
            "text": "custom phrase…"
          }
        ],
        "previousStatement": ["capability", "object", "purpose", "condition"],
        "nextStatement": ["capability", "object", "purpose", "condition"],
        "colour": 260,
        "tooltip": "Flexible custom phrase. Can connect in several positions.",
        "helpUrl": ""
      }
    ]);

    // ========== Toolbox ==========
    function buildToolbox() {
      const libraryByType = {};
      for (const piece of pieceLibrary) {
        if (!libraryByType[piece.type]) libraryByType[piece.type] = [];
        libraryByType[piece.type].push(piece);
      }

      function libBlocks(type) {
        return (libraryByType[type] || []).map(p => ({
          kind: 'block',
          type: p.type,
          fields: { TEXT: p.text }
        }));
      }

      return {
        kind: 'categoryToolbox',
        contents: [
          {
            kind: 'category',
            name: 'Start / Modal',
            colour: '230',
            contents: [
              { kind: 'block', type: 'req_start' },
              { kind: 'block', type: 'req_start_alt' },
              ...libBlocks('req_start'),
              ...libBlocks('req_start_alt')
            ]
          },
          {
            kind: 'category',
            name: 'Capability',
            colour: '180',
            contents: [
              { kind: 'block', type: 'req_capability' },
              { kind: 'block', type: 'req_capability_2' },
              ...libBlocks('req_capability'),
              ...libBlocks('req_capability_2')
            ]
          },
          {
            kind: 'category',
            name: 'Object',
            colour: '160',
            contents: [
              { kind: 'block', type: 'req_object' },
              { kind: 'block', type: 'req_object_2' },
              ...libBlocks('req_object'),
              ...libBlocks('req_object_2'),
              ...libBlocks('req_any_of')
            ]
          },
          {
            kind: 'category',
            name: 'Purpose',
            colour: '40',
            contents: [
              { kind: 'block', type: 'req_purpose' },
              { kind: 'block', type: 'req_purpose_2' },
              ...libBlocks('req_purpose'),
              ...libBlocks('req_purpose_2')
            ]
          },
          {
            kind: 'category',
            name: 'Condition',
            colour: '0',
            contents: [
              { kind: 'block', type: 'req_condition' },
              { kind: 'block', type: 'req_condition_2' },
              ...libBlocks('req_condition'),
              ...libBlocks('req_condition_2')
            ]
          },
          {
            kind: 'category',
            name: 'List',
            colour: '300',
            contents: [
              { kind: 'block', type: 'req_any_of' },
              { kind: 'block', type: 'req_list_item' },
              ...libBlocks('req_list_item')
            ]
          },
          {
            kind: 'category',
            name: 'Custom',
            colour: '260',
            contents: [
              { kind: 'block', type: 'req_custom' },
              ...libBlocks('req_custom')
            ]
          }
        ]
      };
    }

    // ========== Workspace ==========
    const workspace = Blockly.inject('blocklyDiv', {
      toolbox: buildToolbox(),
      trashcan: true,
      scrollbars: true,
      grid: { spacing: 20, length: 3, colour: '#334155', snap: true },
      zoom: { controls: true, wheel: true, startScale: 1.0, maxScale: 2, minScale: 0.4, scaleSpeed: 1.1 },
      renderer: 'geras',
      theme: Blockly.Themes.Classic
    });

    // ========== State ==========
    const STORAGE_KEY = 'requirementScratch_v1';
    const SETTINGS_KEY = 'requirementScratch_settings_v1';

    let pages = [{ id: 1, name: 'Page 1', savedRequirements: [], workspaceState: null }];
    let currentPageId = 1;
    let nextPageId = 2;
    let pieceLibrary = [
      { type